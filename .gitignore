# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Generated output — fully regenerable via `python scripts/run_all.py`.
# Everything needed for review (figures, result tables) is committed under
# figures/ and data/tables/, so output/ need not be tracked.
output/

# cid2code.txt is a 1.9 MB Adobe CMap resource used by the (offline) PDF
# decoder in the extraction tooling; it is fetched on demand, not committed.
cid2code.txt

# LaTeX / paper build artefacts (kept out of the code repository)
*.aux
*.log
*.out
*.toc
*.synctex.gz

# matplotlib font cache
fontlist-*.json
